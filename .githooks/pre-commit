#!/bin/sh
# Pre-commit hook to run formatting, lints and tests before committing

echo "=== Running Git Pre-Commit Checks ==="

echo "Checking formatting: dart format..."
dart format --output=none --set-exit-if-changed .
if [ $? -ne 0 ]; then
  echo "❌ Error: Code is not formatted. Run 'dart format .' and commit again."
  exit 1
fi

echo "Running linter: flutter analyze..."
flutter analyze --no-fatal-infos
if [ $? -ne 0 ]; then
  echo "❌ Error: flutter analyze failed. Commit aborted."
  exit 1
fi

echo "Running tests: flutter test..."
flutter test
if [ $? -ne 0 ]; then
  echo "❌ Error: flutter tests failed. Commit aborted."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
exit 0
